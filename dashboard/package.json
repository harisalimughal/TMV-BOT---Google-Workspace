{
  "name": "tmv-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "TMV Operations Dashboard (/ops)",
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "npm run build --prefix web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'No lint errors'",
    "test": "vitest run"
  },
  "dependencies": {
    "luxon": "^3.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
