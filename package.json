{
  "name": "tmv-bot",
  "version": "1.1.0",
  "private": true,
  "description": "TMV deterministic Google Chat operations bot backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run build && npm run dashboard:build:server && node verify/flow.js && node verify/harness.js && node verify/admin.js && node verify/ops.js",
    "preflight": "tsx verify/preflight.ts",
    "sweep": "curl -s -X POST -H 'Content-Type: application/json' -H \"x-tmv-worker-secret: $TMV_WORKER_SHARED_SECRET\" -d '{\"type\":\"SWEEP_STALE_EVIDENCE\"}' http://localhost:8080/internal/tasks/sweep-evidence",
    "test": "vitest run",
    "test:watch": "vitest",
    "dashboard:build": "npm run build --prefix dashboard/web",
    "dashboard:build:server": "tsc -p dashboard/tsconfig.json",
    "dashboard:test": "vitest run --config dashboard/vitest.config.ts",
    "ci": "npm run typecheck && npm run test && npm run dashboard:test && npm run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.1",
    "googleapis": "^144.0.0",
    "luxon": "^3.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
