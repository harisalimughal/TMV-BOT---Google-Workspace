# ---------------------------------------------------------------------------
# TMV Bot - LOCAL DEVELOPMENT
#
# Production does NOT use this file. Cloud Run gets its config from deploy/deploy.sh
# (env vars) and Secret Manager. Never commit a filled-in .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# --- Google resources (carried over from your existing setup) ---
GOOGLE_SHEETS_SPREADSHEET_ID=1y-a7hOasNJPPAGl_IDxEjLSCmhDWnK7mzKi_jpXHprg
GOOGLE_CALENDAR_ID=c_d21a424c830ab70158fa3955016856b39f63f4480fc3580fa54bbd66654e2e48@group.calendar.google.com
GOOGLE_DRIVE_ROOT_FOLDER_ID=17vcZxrulWnEkntess7xKIlyZVHVHrFut

# --- Authentication ---
# PREFERRED, and the only supported production path: leave these blank and let
# GoogleAuth use Application Default Credentials.
#   local : gcloud auth application-default login
#   cloud : attach the service account to the Cloud Run service
# A key here is for local development only, and the server warns if one is set in
# production. Required only for Gmail domain-wide delegation.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Set this to enable customer emails. Requires domain-wide delegation for
# https://www.googleapis.com/auth/gmail.send. Blank = start emails are skipped.
GOOGLE_WORKSPACE_IMPERSONATED_USER=

# --- Chat endpoint ---
# REQUIRED. The public HTTPS URL Chat calls back for card button actions.
# Locally this is your tunnel URL; in production deploy.sh sets it automatically.
TMV_CHAT_ACTION_URL=
GOOGLE_CHAT_AUDIENCE=

# Verification defaults to TRUE and is mandatory in production. Turning it off
# locally is the only supported use; with it off, any caller can forge a driver
# identity and drive a job to COMPLETED.
VERIFY_CHAT_REQUESTS=false

# Expected signer of the Chat bearer token. Leave blank for a classic Chat app
# (defaults to chat@system.gserviceaccount.com). If your Chat app has "Build this
# Chat app as a Workspace add-on" checked (Chat API > Configuration), set this to the
# "Service Account Email" shown on that page instead — it looks like
# service-<project-number>@gcp-sa-gsuiteaddons.iam.gserviceaccount.com.
GOOGLE_CHAT_ISSUER=

# --- Business rules ---
TMV_TIMEZONE=Europe/London
TMV_OVERTIME_RATE_PER_30_MINUTES=55
TMV_OVERTIME_GRACE_MINUTES=0
TMV_CONGESTION_CHARGE=18
TMV_TUNNEL_CHARGE=13
TMV_MAX_IMAGE_BYTES=10485760
TMV_NOTIFICATION_FROM_NAME=The Man Van

# --- Background work ---
# inline      : runs in-process after the reply. Local development only, UNLESS
#               TMV_ALLOW_INLINE_IN_PRODUCTION=true (see below).
# cloud-tasks : durable and retried. Set by deploy.sh in production.
TMV_QUEUE_DRIVER=inline
# Lets NODE_ENV=production run with TMV_QUEUE_DRIVER=inline. Only safe on a single
# persistent host (e.g. a VPS container that only restarts on crash/redeploy, not one
# that's routinely recycled like Cloud Run) AND only if SWEEP_STALE_EVIDENCE is
# cron-triggered regularly to recover work lost across restarts.
TMV_ALLOW_INLINE_IN_PRODUCTION=false
GCP_PROJECT=
TMV_TASKS_LOCATION=europe-west2
TMV_TASKS_QUEUE=tmv-background
TMV_WORKER_BASE_URL=
TMV_TASKS_SERVICE_ACCOUNT=

# --- Secrets (Secret Manager in production; generate with: openssl rand -hex 32) ---
SYNC_SECRET=
TMV_WORKER_SHARED_SECRET=
# Signs the customer signature-pad link (/sign/:jobId). Required in production.
TMV_SIGNATURE_LINK_SECRET=

# --- Startup / caching ---
BOOTSTRAP_ON_START=true
TMV_CALENDAR_SYNC_TTL_MS=120000
TMV_SHEET_CACHE_TTL_MS=10000
TMV_DRIVER_CACHE_TTL_MS=300000
